# Copy to .env and fill secrets. Never commit .env.

# 数据库：本地单用户写作助手，SQLite 单文件即可（零运维）。
# 多进程并发由 WAL + busy_timeout 兜底，无需 PostgreSQL。
# 身份：无登录；DEMO_USER_ID 为常量审计字段（非多租户）。
DATABASE_URL=sqlite:///./data/dev.db

# 本机 API：默认拒绝非回环来源；Docker app profile 强制校验此密钥。
# 使用 python3 -c 'import secrets; print(secrets.token_urlsafe(32))' 生成后填入 .env。
# 前端开发代理与 agent-worker 自动从根 .env 读取；CLI 可 export 同名变量。
# 禁止使用 VITE_ 前缀存放密钥，禁止把它放进浏览器代码或 URL。
LOCAL_API_TOKEN=
LOCAL_API_REQUIRE_TOKEN=false

# Redis（本地默认基础设施；pnpm docker:up 只起 Redis）
REDIS_URL=redis://127.0.0.1:6379/0

# MinIO（可选；pnpm docker:up:heavy。未起时 KB 上传走本地 uploads）
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=xiezuomanju
MINIO_SECURE=false

# Milvus（可选；pnpm docker:up:heavy。未起时向量走内存/hash 回退）
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=kb_chunks

# LLM — 当前默认 MiniMax；启动后可在「设置 → AI 服务商」自由切换。
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3.1-Flash
LLM_DEFAULT_PROVIDER=minimax
# Agent 长上下文/工具调用单次请求超时（秒，可在部署环境覆盖）
AGENT_LLM_TIMEOUT_S=600
# agent-worker 并发上限（1–16）；运行期可由设置页「流量治理」下调，429 时自适应掉队
AGENT_WORKER_CONCURRENCY=4
# 所有模型请求（含 Personal Agent）共用容量；订阅 Key 的实际额度以账户套餐为准。
LLM_ADMISSION_WAIT_S=30
# 跨进程请求起步间隔，用于平滑突发；不是 MiniMax 官方 RPM 权益，0 可关闭。
LLM_MIN_REQUEST_INTERVAL_S=0.3
# 被明确拒绝的模型请求在本轮内等待重试；不重放已执行的写工具。
AGENT_MODEL_RETRY_MAX_WAIT_MS=120000
AGENT_MODEL_RETRY_MAX_ATTEMPTS=12
# MiniMax 不要设 AGENT_REASONING_EFFORT=none（会 400）；留空即可，或仅在确知兼容时设置 low/medium/high。

# DeepSeek 作为可选服务商保留；未在设置中切换时不会覆盖默认 MiniMax。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# API/知识库侧的 OpenAI 兼容 provider（网关 openai_compat 分支）
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=

# 备注：M Plan 的 API key 从 https://platform.minimaxi.com 获取；
# 国际版（minimax.io）与国内版（minimaxi.com）域名二选一，需与 key 所属平台一致。

# Fernet key for encrypting stored provider API keys (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SECRETS_FERNET_KEY=

# 联网搜索：默认使用「设置 → 模型 Provider」中默认启用、支持内置联网能力的
# OpenAI 兼容模型（DeepSeek / MiniMax / GLM / Kimi），只需填写 URL + API Key。
# 未配置任何可用 Provider 时，界面会如实显示「联网搜索未启用」，不做假搜索。
# Bocha / Serper 仅作为外部搜索源兜底（可选）。
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=bocha
BOCHA_API_KEY=
SERPER_API_KEY=

# Embeddings (OpenAI-compatible; DeepSeek may not expose embeddings — use compatible endpoint or local)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# API
API_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
DEMO_USER_ID=00000000-0000-4000-8000-000000000001
SEED_ON_START=true

# 飞书（WebSocket 长连接；仅放 .env，勿提交）— 可选进程，非本地默认必开
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 群聊策略：mention=需 @bot；always=任意消息响应
FEISHU_GROUP_POLICY=mention
# 主动提案/提醒默认推送目标（chat_id，如 oc_xxx）；空则用最近飞书会话
FEISHU_DEFAULT_CHAT_ID=
# Personal Agent 确认超时自动应答（分钟）；到点未操作即默认批准继续
PERSONAL_AGENT_CONFIRM_TIMEOUT_MIN=10
PERSONAL_AGENT_AUTO_RESPOND=true
# AgentRun 卡住超过该分钟数则飞书 Watchdog 提醒
FEISHU_WATCHDOG_STUCK_MINUTES=15
# 飞书进度：false=合并批处理；true=逐条 tool_call
FEISHU_PROGRESS_VERBOSE=false

# —— Agent 执行路径 ——
# agent.* 只由 Node agent-worker 消费（读 SKILL + Tools），走 jobs:agent。
AGENT_WORKER_API_BASE=http://127.0.0.1:8000
# Node agent-worker 只监听此键；勿用 JOB_QUEUE_KEY=jobs:queue 覆盖
JOB_AGENT_QUEUE_KEY=jobs:agent
JOB_QUEUE_KEY=jobs:queue
# Harness：安全模式 readonly|safe|yolo；结束前强制 Done Contract；会话 JSONL 根目录
AGENT_SECURITY_MODE=safe
AGENT_MAX_TURNS=16
# 连续无新产物/新门禁证据的停滞轮数上限（默认 12；弱模型建议 16）
AGENT_STAGNANT_TURNS=12
AGENT_ENFORCE_DONE=true
# Agent 会话引擎：自研 OpenAI-compatible tool loop（唯一执行路径）。
# Agent 模型的默认路径每轮读取「设置」中的当前服务商/模型，不再依赖启动时模型环境变量。
# 可选：子智能体走独立进程（fork 隔离）；默认 false，保留进程内嵌套。fork 失败时自动回退进程内
# AGENT_SUBAGENT_FORK=true
# 会话 JSONL 根目录；留空时 worker 默认落盘到 .data/sessions（已 gitignore）
# AGENT_SESSION_ROOT=.data/sessions
# OpenTelemetry（默认关；无 collector 时也不阻断 worker）
AGENT_OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=xiezuomanju-agent-worker

# Crawler cookies（起点/红果/七猫等反爬时需要；也可在爬虫页粘贴）
# 仅抓公开榜摘要，禁止整本/付费章
CRAWLER_COOKIE_FANQIE=
CRAWLER_COOKIE_JINJIANG=
CRAWLER_COOKIE_FEILU=
CRAWLER_COOKIE_QIMAO=
CRAWLER_COOKIE_QIDIAN=
CRAWLER_COOKIE_HONGGUO=
