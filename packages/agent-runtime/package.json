{
  "name": "@xiezuomanju/agent-runtime",
  "license": "Apache-2.0",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/**/*.test.ts",
    "sync-skills-catalog": "node --experimental-strip-types ./scripts/sync-skills-catalog.ts",
    "sync-agent-catalog": "node --experimental-strip-types ./scripts/sync-agent-catalog.ts",
    "sync-stage-graphs": "node --experimental-strip-types ./scripts/sync-stage-graphs.ts",
    "sync-loop-graphs": "node --experimental-strip-types ./scripts/sync-loop-graphs.ts",
    "sync-catalogs": "pnpm run sync-skills-catalog && pnpm run sync-agent-catalog && pnpm run sync-stage-graphs && pnpm run sync-loop-graphs",
    "check-stage-graph-drift": "node --experimental-strip-types ./scripts/check-stage-graph-drift.ts",
    "check-loop-graph-drift": "node --experimental-strip-types ./scripts/check-loop-graph-drift.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
