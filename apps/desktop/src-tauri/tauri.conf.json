{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI 商业写作台",
  "version": "0.1.0",
  "identifier": "com.xiezuomanju.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @xiezuomanju/ai-writing dev --host 127.0.0.1 --port 5173",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm --filter @xiezuomanju/ai-writing build",
    "frontendDist": "../../ai-writing/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI 商业写作台",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
